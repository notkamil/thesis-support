# Configuration for benchmarks/scripts/bootstrap.sh.
#
# Override any value via the corresponding CLI flag on bootstrap.sh, e.g.:
#   ./scripts/bootstrap.sh --rev <sha>
#   ./scripts/bootstrap.sh --repo <url>

# Git remote that hosts the otterbrix repository to benchmark against.
# Must be a public clone URL (https or ssh).
REPO_URL="https://github.com/notkamil/otterbrix.git"

# Git ref to check out: branch name, tag, or full SHA.
# Pinned to a specific commit so the numbers from any bootstrap are
# byte-for-byte reproducible. To re-pin after upstream changes:
#   git ls-remote $REPO_URL rust-ffi-bindings
DEFAULT_REV="91707eb4239fb6556b44066a56df44f88dbc1264"

# CMake build type for libotterbrix.so. Release is the only supported
# value for benchmarking; Debug numbers are not meaningful.
CMAKE_BUILD_TYPE="Release"

# Extra flags appended to CXXFLAGS during cmake configure (rarely needed).
EXTRA_CXX_FLAGS=""

# Number of parallel jobs for the C++ build. Defaults to all CPUs if empty.
JOBS=""
